# Local SQLite database file (libsql). Copy to .env for local dev.
DATABASE_URL=file:./data/coach.db

# Anthropic API key for AI features (added in Phase 6). Never commit the real key.
# ANTHROPIC_API_KEY=sk-ant-...

# Nightly SQLite backups (Phase 8). All optional — sensible defaults shown.
# BACKUP_DIR defaults to a `backups/` dir next to the db file (e.g. data/backups).
# BACKUP_RETENTION is how many recent snapshots to keep. BACKUP_HOUR is the local
# hour (0–23) the nightly backup runs.
# BACKUP_DIR=./data/backups
# BACKUP_RETENTION=14
# BACKUP_HOUR=3
